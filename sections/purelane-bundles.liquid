{% comment %}
  Purelane Bundles Section
  Tier pricing with product selection
{% endcomment %}

<link rel="stylesheet" href="{{ 'purelane-bundles.css' | asset_url }}">

<section class="purelane-bundles sec" id="purelane-bundles-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {% if section.settings.kicker != blank %}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {% endif %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <p class="lede" style="margin:0 auto">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    </div>

    <div class="purelane-bundles__tiers">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <article class="purelane-bundles__tier glass rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %} {% if block.settings.is_best %}purelane-bundles__tier--best{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.tag_text != blank %}
              <span class="purelane-bundles__tag">{{ block.settings.tag_text }}</span>
            {% endif %}

            {% if block.settings.show_products %}
              <div class="purelane-bundles__product-images {% if block.settings.product_count == '5' %}purelane-bundles__product-images--five{% endif %}">
                {% if block.settings.product_1 != blank and block.settings.product_1.featured_image %}
                  <span class="purelane-bundles__product-image" style="background-image: url('{{ block.settings.product_1.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ block.settings.product_1.title }}"></span>
                {% endif %}
                {% if block.settings.product_2 != blank and block.settings.product_2.featured_image %}
                  <span class="purelane-bundles__product-image" style="background-image: url('{{ block.settings.product_2.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ block.settings.product_2.title }}"></span>
                {% endif %}
                {% if block.settings.product_3 != blank and block.settings.product_3.featured_image %}
                  <span class="purelane-bundles__product-image" style="background-image: url('{{ block.settings.product_3.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ block.settings.product_3.title }}"></span>
                {% endif %}
                {% if block.settings.product_4 != blank and block.settings.product_4.featured_image %}
                  <span class="purelane-bundles__product-image" style="background-image: url('{{ block.settings.product_4.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ block.settings.product_4.title }}"></span>
                {% endif %}
                {% if block.settings.product_5 != blank and block.settings.product_5.featured_image %}
                  <span class="purelane-bundles__product-image" style="background-image: url('{{ block.settings.product_5.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ block.settings.product_5.title }}"></span>
                {% endif %}
              </div>
            {% endif %}

            <div class="purelane-bundles__qty">
              {{ block.settings.product_count }}
              <small>Products</small>
            </div>

            <div class="purelane-bundles__price">
              {{ block.settings.price }}
              {% if block.settings.compare_price != blank %}
                <s>{{ block.settings.compare_price }}</s>
              {% endif %}
            </div>

            {% if block.settings.price_note != blank %}
              <p class="body-s" style="font-size:12px">{{ block.settings.price_note }}</p>
            {% endif %}

            {% if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank %}
              <ul class="purelane-bundles__features">
                {% if block.settings.feature_1 != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.feature_1 }}
                  </li>
                {% endif %}
                {% if block.settings.feature_2 != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.feature_2 }}
                  </li>
                {% endif %}
                {% if block.settings.feature_3 != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.feature_3 }}
                  </li>
                {% endif %}
              </ul>
            {% endif %}

            <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link }}">
              {{ block.settings.cta_text | default: 'Build this box' }}
              {% if block.settings.is_best %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              {% endif %}
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "section-purelane-bundles",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "limit": 3,
      "settings": [
        {
          "type": "header",
          "content": "Tier Details"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag Text",
          "default": "Starter",
          "info": "e.g., 'Starter', 'Most popular', 'Whole home'"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product Count",
          "default": "2"
        },
        {
          "type": "header",
          "content": "Pricing"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Price Note",
          "default": "Flat ₹174 per product",
          "info": "Optional"
        },
        {
          "type": "header",
          "content": "Features"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "header",
          "content": "Products (Optional)"
        },
        {
          "type": "checkbox",
          "id": "show_products",
          "label": "Show product images",
          "default": false
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Styling"
        },
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Mark as best value",
          "default": false,
          "info": "Adds accent border and primary CTA button"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag_text": "Starter",
            "product_count": "2",
            "price": "₹349",
            "compare_price": "₹598"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_text": "Most popular",
            "product_count": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "is_best": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_text": "Whole home",
            "product_count": "5",
            "price": "₹799",
            "compare_price": "₹1495"
          }
        }
      ]
    }
  ]
}
{% endschema %}
