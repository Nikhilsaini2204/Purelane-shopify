{% comment %}
  Purelane Hero Section
  Reproduces the hero from the prototype with product slider, badges, and CTAs
{% endcomment %}

<link rel="stylesheet" href="{{ 'purelane-hero.css' | asset_url }}">

<section class="purelane-hero" id="purelane-hero-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="purelane-hero__grid wrap">

    {% comment %} Badge Rail - Desktop Only {% endcomment %}
    <div class="purelane-hero__badges glass-2" aria-label="Product promises">
      <div class="purelane-hero__badge">
        <span class="purelane-hero__badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>
        <span>{{ section.settings.badge_1_text }}</span>
      </div>
      <div class="purelane-hero__badge">
        <span class="purelane-hero__badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>
        <span>{{ section.settings.badge_2_text }}</span>
      </div>
      <div class="purelane-hero__badge">
        <span class="purelane-hero__badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>
        <span>{{ section.settings.badge_3_text }}</span>
      </div>
    </div>

    {% comment %} Hero Copy {% endcomment %}
    <div class="purelane-hero__copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading | newline_to_br }}
      </h1>

      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      <p class="lede rv rv-d2">{{ section.settings.description }}</p>

      <div class="purelane-hero__cta rv rv-d3">
        {% if section.settings.primary_cta_text != blank %}
          <a class="btn btn-primary" href="{{ section.settings.primary_cta_link }}">
            {{ section.settings.primary_cta_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.secondary_cta_text != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.secondary_cta_link }}">
            {{ section.settings.secondary_cta_text }}
          </a>
        {% endif %}
      </div>

      {% comment %} Badge Strip - Mobile Only {% endcomment %}
      <div class="purelane-hero__badge-strip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          {{ section.settings.badge_1_text | split: '<br>' | first }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
          {{ section.settings.badge_2_text | split: '<br>' | first }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
          {{ section.settings.badge_3_text | split: '<br>' | first }}
        </div>
      </div>
    </div>

    {% comment %} Hero Product Stage {% endcomment %}
    <div class="purelane-hero__products">
      <div class="purelane-hero__stage" data-hero-stage>
        {% for block in section.blocks %}
          {% if block.type == 'product_slide' and block.settings.product != blank %}
            {% assign product = block.settings.product %}
            <div class="purelane-hero__slide {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
              {% if product.featured_image %}
                <div class="purelane-hero__product-image">
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w,
                            {{ product.featured_image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 1200px) 560px, (min-width: 900px) 50vw, 88vw"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                </div>
              {% endif %}

              {% if block.settings.show_price %}
                <div class="purelane-hero__price glass-2">
                  <span class="purelane-hero__price-label">{{ block.settings.price_label }}</span>
                  <span class="purelane-hero__price-value">
                    <strong>{{ block.settings.offer_price }}</strong>
                    {% if block.settings.compare_price != blank %}
                      <s>{{ block.settings.compare_price }}</s>
                    {% endif %}
                  </span>
                  {% if block.settings.savings_text != blank %}
                    <span class="purelane-hero__price-cut">{{ block.settings.savings_text }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="purelane-hero__dots" data-hero-dots>
          {% for block in section.blocks %}
            {% if block.type == 'product_slide' and block.settings.product != blank %}
              <button type="button" class="{% if forloop.first %}active{% endif %}" aria-label="Show slide {{ forloop.index }}" data-dot="{{ forloop.index0 }}"></button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<script>
(function() {
  const sectionId = 'purelane-hero-{{ section.id }}';
  const section = document.getElementById(sectionId);
  if (!section) return;

  const stage = section.querySelector('[data-hero-stage]');
  const dots = section.querySelectorAll('[data-hero-dots] button');
  const slides = section.querySelectorAll('[data-hero-stage] .purelane-hero__slide');

  if (slides.length <= 1) return;

  let currentIndex = 0;
  let autoplayTimer = null;
  const autoplayDelay = {{ section.settings.autoplay_delay | default: 3800 }};
  const shouldAutoplay = {{ section.settings.enable_autoplay }};
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goToSlide(index) {
    if (index < 0 || index >= slides.length) return;

    slides[currentIndex].classList.remove('active');
    dots[currentIndex].classList.remove('active');

    currentIndex = index;

    slides[currentIndex].classList.add('active');
    dots[currentIndex].classList.add('active');
  }

  function nextSlide() {
    goToSlide((currentIndex + 1) % slides.length);
  }

  function startAutoplay() {
    if (!shouldAutoplay || reduceMotion) return;
    stopAutoplay();
    autoplayTimer = setInterval(nextSlide, autoplayDelay);
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  // Dot navigation
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      stopAutoplay();
      goToSlide(index);
      startAutoplay();
    });
  });

  // Pause on hover
  stage.addEventListener('mouseenter', stopAutoplay);
  stage.addEventListener('mouseleave', startAutoplay);

  // Pause when not visible
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          startAutoplay();
        } else {
          stopAutoplay();
        }
      });
    }, { threshold: 0.2 });
    observer.observe(stage);
  } else {
    startAutoplay();
  }

  // Clean up on section unload
  document.addEventListener('shopify:section:unload', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      stopAutoplay();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "section-purelane-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Clean\nThat\nLasts",
      "info": "Use line breaks for multi-line headings. Wrap text with <span class='lime'></span> for accent color."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "header",
      "content": "Call to Actions"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Plant<br>powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Safe for<br>kids & pets"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Zero harsh<br>chemicals"
    },
    {
      "type": "header",
      "content": "Product Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay (ms)",
      "min": 2000,
      "max": 8000,
      "step": 200,
      "default": 3800
    }
  ],
  "blocks": [
    {
      "type": "product_slide",
      "name": "Product Slide",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show price tag",
          "default": true
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Single bottle",
          "info": "e.g., 'Single bottle', 'Any 2 products', 'Any 3 products'"
        },
        {
          "type": "text",
          "id": "offer_price",
          "label": "Offer price",
          "default": "₹200",
          "info": "Enter the display price with currency symbol"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at price",
          "default": "₹299",
          "info": "Optional - shows as strikethrough"
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings text",
          "default": "33% off",
          "info": "Optional - e.g., '33% off' or 'Save ₹99'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        {
          "type": "product_slide",
          "settings": {
            "price_label": "Single bottle",
            "offer_price": "₹200",
            "compare_price": "₹299",
            "savings_text": "33% off"
          }
        }
      ]
    }
  ]
}
{% endschema %}
