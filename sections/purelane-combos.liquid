{% comment %}
  Purelane Best-selling Combos Section
  Horizontal scrolling combo cards with product bundles
{% endcomment %}

<link rel="stylesheet" href="{{ 'purelane-combos.css' | asset_url }}">

<section class="purelane-combos sec" id="purelane-combos-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      {% if section.settings.description != blank %}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="purelane-combos__rail rv">
      {% for block in section.blocks %}
        {% if block.type == 'combo' %}
          <article class="purelane-combos__card glass {% if block.settings.is_hero %}purelane-combos__card--hero{% endif %}" {{ block.shopify_attributes }}>
            <div class="purelane-combos__tray">
              {% if block.settings.savings_text != blank %}
                <span class="purelane-combos__save">{{ block.settings.savings_text }}</span>
              {% endif %}
              {% if block.settings.flag_text != blank %}
                <span class="purelane-combos__flag">{{ block.settings.flag_text }}</span>
              {% endif %}

              <div class="purelane-combos__stack">
                {% if block.settings.product_1 != blank %}
                  {% assign product_1 = block.settings.product_1 %}
                  <span class="purelane-combos__item">
                    {% if product_1.featured_image %}
                      <span class="purelane-combos__item-image" style="background-image: url('{{ product_1.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ product_1.title }}"></span>
                    {% else %}
                      <span class="purelane-combos__item-tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <rect x="3" y="3" width="18" height="18" rx="2"/>
                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <path d="M21 15l-5-5L5 21"/>
                        </svg>
                      </span>
                    {% endif %}
                    <span>{{ block.settings.product_1_subtitle | default: product_1.title | truncate: 30 }}</span>
                  </span>
                {% endif %}

                <span class="purelane-combos__plus" aria-hidden="true">+</span>

                {% if block.settings.product_2 != blank %}
                  {% assign product_2 = block.settings.product_2 %}
                  <span class="purelane-combos__item">
                    {% if product_2.featured_image %}
                      <span class="purelane-combos__item-image" style="background-image: url('{{ product_2.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ product_2.title }}"></span>
                    {% else %}
                      <span class="purelane-combos__item-tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <rect x="3" y="3" width="18" height="18" rx="2"/>
                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <path d="M21 15l-5-5L5 21"/>
                        </svg>
                      </span>
                    {% endif %}
                    <span>{{ block.settings.product_2_subtitle | default: product_2.title | truncate: 30 }}</span>
                  </span>
                {% endif %}

                {% if block.settings.product_3 != blank %}
                  <span class="purelane-combos__plus" aria-hidden="true">+</span>
                  {% assign product_3 = block.settings.product_3 %}
                  <span class="purelane-combos__item">
                    {% if product_3.featured_image %}
                      <span class="purelane-combos__item-image" style="background-image: url('{{ product_3.featured_image | image_url: width: 200 }}');" role="img" aria-label="{{ product_3.title }}"></span>
                    {% else %}
                      <span class="purelane-combos__item-tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <rect x="3" y="3" width="18" height="18" rx="2"/>
                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <path d="M21 15l-5-5L5 21"/>
                        </svg>
                      </span>
                    {% endif %}
                    <span>{{ block.settings.product_3_subtitle | default: product_3.title | truncate: 30 }}</span>
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="purelane-combos__body">
              <h3>{{ block.settings.title }}</h3>
              <div class="purelane-combos__count">{{ block.settings.product_count }} products</div>
              {% if block.settings.description != blank %}
                <p class="purelane-combos__description">{{ block.settings.description }}</p>
              {% endif %}

              <div class="purelane-combos__price-row">
                {% if block.settings.price != blank %}
                  <strong>{{ block.settings.price }}</strong>
                {% endif %}
                {% if block.settings.compare_price != blank %}
                  <s>{{ block.settings.compare_price }}</s>
                {% endif %}
                {% if block.settings.savings_badge != blank %}
                  <em>{{ block.settings.savings_badge }}</em>
                {% endif %}
              </div>

              {% if block.settings.fine_print != blank %}
                <div class="purelane-combos__fine">{{ block.settings.fine_print }}</div>
              {% endif %}

              <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link }}">
                {{ block.settings.cta_text | default: 'Shop bundle' }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              </a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="purelane-combos__swipe-cue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>
      Swipe for more combos
    </div>

    {% if section.settings.note != blank %}
      <p class="purelane-combos__note">{{ section.settings.note }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "section-purelane-combos",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Footer Note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "header",
          "content": "Combo Details"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Combo Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product Count",
          "default": "3"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen."
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "product_1_subtitle",
          "label": "Product 1 Subtitle",
          "info": "Optional - overrides product title"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "product_2_subtitle",
          "label": "Product 2 Subtitle"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3",
          "info": "Optional"
        },
        {
          "type": "text",
          "id": "product_3_subtitle",
          "label": "Product 3 Subtitle"
        },
        {
          "type": "header",
          "content": "Pricing"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings Text (top)",
          "default": "You save ₹398"
        },
        {
          "type": "text",
          "id": "savings_badge",
          "label": "Savings Badge (inline)",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine Print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Badges"
        },
        {
          "type": "checkbox",
          "id": "is_hero",
          "label": "Mark as featured",
          "default": false,
          "info": "Adds accent border and primary CTA button"
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Flag Text",
          "info": "e.g., 'Most popular', 'Best value'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}
